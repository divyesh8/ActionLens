# Server-only Edge Function secrets. Never expose these through EXPO_PUBLIC_*.
OPENAI_API_KEY=replace-with-a-server-only-key
OPENAI_MODEL=replace-with-a-structured-output-capable-model
OPENAI_OCR_MODEL=replace-with-an-image-and-pdf-capable-model

# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are supplied
# automatically by a deployed Supabase project. Set them explicitly only for
# local Edge Function serving.
