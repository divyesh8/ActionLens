# Public mobile configuration. These values are safe to include in a client bundle.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anonymous-or-publishable-key

# No OpenAI, OCR-provider, or model API key is required. Document OCR and
# analysis run locally in the browser. Supabase supplies its own privileged
# variables automatically to the deployed deletion functions.
