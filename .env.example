# Public mobile configuration. These values are safe to include in a client bundle.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anonymous-or-publishable-key

# Server-only secrets such as SUPABASE_SERVICE_ROLE_KEY and AI/OCR provider keys
# belong in Supabase Edge Function secrets, never in this file.
# Required server secret names are documented in supabase/functions/.env.example.
